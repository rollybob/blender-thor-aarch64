From 8c3ebe69405ecc408d40ad7821227f49543410fb Mon Sep 17 00:00:00 2001
From: Thor aarch64 build <thor-build@localhost>
Date: Sun, 20 Sep 2026 19:10:06 -0400
Subject: [PATCH 3/8] deps/osl: do not force OSL_USE_OPTIX=ON on ARM (CPU-only
 OSL)

Upstream forces OSL's OptiX path on, which compiles OSL shadeops to PTX via
clang and breaks on CUDA 13 + clang 17 in texture_fetch_functions.h. Pointless
on Jetson (no OptiX runtime; Blender built WITH_CYCLES_DEVICE_OPTIX=OFF, so
Cycles runs OSL on CPU). Leaving OSL_USE_OPTIX=OFF skips the CUDA_FOUND-gated
GPU-shadeops block; only the CPU LLVM-bitcode path builds.
---
 build_files/build_environment/cmake/osl.cmake | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/build_files/build_environment/cmake/osl.cmake b/build_files/build_environment/cmake/osl.cmake
index d5e4ef8ed4f..ded7d5fd356 100644
--- a/build_files/build_environment/cmake/osl.cmake
+++ b/build_files/build_environment/cmake/osl.cmake
@@ -57,7 +57,15 @@ set(OSL_EXTRA_ARGS
   -Dlibdeflate_DIR=${LIBDIR}/deflate/lib/cmake/libdeflate
 )
 
-if(NOT (APPLE OR BLENDER_PLATFORM_WINDOWS_ARM))
+# Thor aarch64 (BLENDER_PLATFORM_ARM): build CPU-only OSL, i.e. leave OSL_USE_OPTIX at its
+# upstream default of OFF. The OptiX/CUDA shadeops path compiles OSL's shadeops to PTX via
+# clang (LLVM_COMPILE_CUDA), which on CUDA 13 + our clang 17 breaks inside the CUDA runtime
+# header texture_fetch_functions.h. It is also useless here: Jetson has no OptiX runtime,
+# Blender is built WITH_CYCLES_DEVICE_OPTIX=OFF, and Cycles on the CUDA (non-OptiX) device
+# runs OSL on the CPU only. With OSL_USE_OPTIX=OFF, find_package(CUDA) is never called, so
+# the CUDA_FOUND-gated block in src/liboslexec/CMakeLists.txt is skipped and only the CPU
+# LLVM-bitcode path (USE_LLVM_BITCODE=ON) is compiled.
+if(NOT (APPLE OR BLENDER_PLATFORM_WINDOWS_ARM OR BLENDER_PLATFORM_ARM))
   list(APPEND OSL_EXTRA_ARGS
     -DOSL_USE_OPTIX=ON
     -DCUDA_TARGET_ARCH=sm_50

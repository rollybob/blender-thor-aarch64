From 09f0372b8cf96acb16b5e2bdb2f1b8ab9d6fbf1b Mon Sep 17 00:00:00 2001
From: Thor aarch64 build <thor-build@localhost>
Date: Sun, 20 Sep 2026 19:10:06 -0400
Subject: [PATCH 4/8] deps/oidn: enable CUDA GPU device on sm_110
 (RuntimeStatic + arch fixups; CUDA 13, OIDN 2.5.0)

Enables GPU OpenImageDenoise on Thor. Two parts:
 (1) OIDN_DEVICE_CUDA_API=RuntimeStatic: OIDN's default Driver backend (curtn.cpp
     shim) lacks __cudaLaunchKernel, the symbol CUDA 13 nvcc lowers <<<>>> to, so
     the module dlopens with 'undefined symbol: __cudaLaunchKernel' and OIDN
     SILENTLY falls back to CPU. RuntimeStatic links the real libcudart_static.a.
 (2) sm_110 arch fixups via OIDN_PATCH_COMMAND (OIDN 2.5.0 gencode is SASS-only,
     no PTX -> Thor needs a native sm_110 cubin): add 110 to OIDN_CUDA_SM_FLAGS
     and OIDN_CUDA_SM80_FLAGS, and widen isSupported() 109 -> 119 (2.5.0 accepts
     75..109 and 120..129, excluding Thor's 110).

Adapted from the 4.5/OIDN-2.3.3 recipe: the 2.3.3 compute_70 drop and sm70->sm75
retarget are obsolete (2.5.0 ships no sm70 TU / no compute_70), and upstream
fixed the ODIN_PATCH_COMMAND typo to OIDN_PATCH_COMMAND, which we now append to.
---
 .../cmake/openimagedenoise.cmake              | 31 ++++++++++++++++++-
 1 file changed, 30 insertions(+), 1 deletion(-)

diff --git a/build_files/build_environment/cmake/openimagedenoise.cmake b/build_files/build_environment/cmake/openimagedenoise.cmake
index 2ddcbd630d1..9c79275e11b 100644
--- a/build_files/build_environment/cmake/openimagedenoise.cmake
+++ b/build_files/build_environment/cmake/openimagedenoise.cmake
@@ -31,9 +31,18 @@ else()
       -DOIDN_DEVICE_CUDA=ON
       -DOIDN_DEVICE_HIP=ON)
   elseif(UNIX)
+    # Thor/CUDA13 GPU-OIDN (5.2 / OIDN 2.5.0): enable the CUDA device on aarch64.
     set(OIDN_EXTRA_ARGS
       ${OIDN_EXTRA_ARGS}
-      -DOIDN_DEVICE_CUDA=ON)
+      -DOIDN_DEVICE_CUDA=ON
+      -DCUDAToolkit_ROOT=/usr/local/cuda-13
+      # OIDN's default CUDA API mode is "Driver", which links its curtn.cpp shim that reimplements
+      # the CUDA runtime on the driver API. That shim predates CUDA 13 and does NOT provide
+      # __cudaLaunchKernel, the internal launch entry point CUDA 13 lowers <<<>>> to. The module
+      # then fails to dlopen (undefined symbol: __cudaLaunchKernel) and OIDN silently falls back to
+      # CPU. Use RuntimeStatic: statically link the real CUDA 13 libcudart_static.a (has the symbol),
+      # keeping the module self-contained.
+      -DOIDN_DEVICE_CUDA_API=RuntimeStatic)
   endif()
 
 
@@ -100,6 +109,26 @@ if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
   )
 endif()
 
+if(BLENDER_PLATFORM_ARM AND UNIX)
+  # Thor/CUDA13 GPU-OIDN (OIDN 2.5.0): make the CUDA device build for and accept Thor (sm_110).
+  #  1. main engine arch list (cuda_conv/device/engine): add native sm_110. gencode here is
+  #     code=sm_<v> only (NO PTX -> no JIT fallback), so Thor needs a real sm_110 cubin.
+  #  2. sm80 CUTLASS arch list: add sm_110 (Blackwell uses the smArch>=80 conv path). The sm75
+  #     CUTLASS TU is left as-is: nvcc 13 compiles compute_75 fine and Thor never calls the <75>
+  #     conv path, so it is a harmless dead TU that keeps the <75> symbols defined.
+  #  3. isSupported(): stock 2.5.0 accepts 75..109 and 120..129, excluding Thor's 110; widen the
+  #     first range's upper bound 109 -> 119 so OIDN accepts sm_110.
+  # (OIDN 2.3.3's compute_70 drop / sm70->sm75 retarget from the 4.5 recipe is obsolete here: 2.5.0
+  #  already ships no sm70 TU and no compute_70 in its default flags.)
+  set(_OIDN_CUDA_CML ${BUILD_DIR}/openimagedenoise/src/external_openimagedenoise/devices/cuda/CMakeLists.txt)
+  set(_OIDN_CUDA_DEV ${BUILD_DIR}/openimagedenoise/src/external_openimagedenoise/devices/cuda/cuda_device.cpp)
+  set(OIDN_PATCH_COMMAND ${OIDN_PATCH_COMMAND}
+    && sed -i "s/OIDN_CUDA_SM_FLAGS 75 80 90 100 120/OIDN_CUDA_SM_FLAGS 75 80 90 100 110 120/" ${_OIDN_CUDA_CML}
+    && sed -i "s/OIDN_CUDA_SM80_FLAGS 80 90 100 120/OIDN_CUDA_SM80_FLAGS 80 90 100 110 120/" ${_OIDN_CUDA_CML}
+    && sed -i "s/smArch <= 109/smArch <= 119/" ${_OIDN_CUDA_DEV}
+  )
+endif()
+
 ExternalProject_Add(external_openimagedenoise
   URL file://${PACKAGE_DIR}/${OIDN_FILE}
   DOWNLOAD_DIR ${DOWNLOAD_DIR}
-- 

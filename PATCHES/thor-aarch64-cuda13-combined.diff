diff --git a/build_files/build_environment/cmake/openimagedenoise.cmake b/build_files/build_environment/cmake/openimagedenoise.cmake
index 6888111b53c..d0d0b01c821 100644
--- a/build_files/build_environment/cmake/openimagedenoise.cmake
+++ b/build_files/build_environment/cmake/openimagedenoise.cmake
@@ -31,9 +31,22 @@ else()
       -DOIDN_DEVICE_CUDA=ON
       -DOIDN_DEVICE_HIP=ON)
   elseif(UNIX)
+    # Thor/CUDA13 GPU-OIDN (enabled 2026-09-15). OIDN builds native cubins only (NO PTX -> no JIT
+    # fallback), so Thor needs a real sm_110 cubin. nvcc 13 rejects compute_70 (Volta) but supports
+    # compute_75..121 incl. sm_110. The arch-list fixups (drop 70, add 110, retarget the never-used
+    # sm70 CUTLASS TU to 75) + the isSupported() widening are applied as sed patches in
+    # ODIN_PATCH_COMMAND below (search "Thor/CUDA13 GPU-OIDN").
     set(OIDN_EXTRA_ARGS
       ${OIDN_EXTRA_ARGS}
-      -DOIDN_DEVICE_CUDA=ON)
+      -DOIDN_DEVICE_CUDA=ON
+      -DCUDAToolkit_ROOT=/usr/local/cuda-13
+      # OIDN's default CUDA API mode is "Driver", which links its own curtn.cpp shim that
+      # reimplements the CUDA runtime on the driver API. That shim predates CUDA 13 and does NOT
+      # provide __cudaLaunchKernel, the internal launch entry point CUDA 13 lowers <<<>>> to. The
+      # module then fails to dlopen (undefined symbol: __cudaLaunchKernel) and OIDN silently falls
+      # back to CPU. Use RuntimeStatic instead: statically link the real CUDA 13 libcudart_static.a
+      # (has __cudaLaunchKernel), keeping the module self-contained (no external libcudart.so).
+      -DOIDN_DEVICE_CUDA_API=RuntimeStatic)
   endif()
 endif()
 
@@ -79,6 +92,24 @@ if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
   )
 endif()
 
+if(BLENDER_PLATFORM_ARM AND UNIX)
+  # Thor/CUDA13 GPU-OIDN: make OIDN's CUDA device build under CUDA 13 and run on Thor (sm_110).
+  #  1. main engine arch list: drop compute_70 (Volta, rejected by nvcc13), add native sm_110.
+  #  2. sm80 CUTLASS arch list: add sm_110 (Thor uses the smArch>=80 conv path; Blackwell is sm80-class).
+  #  3. sm70 CUTLASS TU: retarget gencode 70->75 so it still compiles+links. It is never called on
+  #     Thor (cuda_conv.cu sends smArch>=80 to getCutlassConvInstances<80>()), so the Turing-arch
+  #     cubin is a harmless dead TU that merely keeps the <70> symbol defined.
+  #  4. isSupported(): stock range excludes 110-119; widen 109->119 so OIDN accepts Thor.
+  set(_OIDN_CUDA_CML ${BUILD_DIR}/openimagedenoise/src/external_openimagedenoise/devices/cuda/CMakeLists.txt)
+  set(_OIDN_CUDA_DEV ${BUILD_DIR}/openimagedenoise/src/external_openimagedenoise/devices/cuda/cuda_device.cpp)
+  set(ODIN_PATCH_COMMAND ${ODIN_PATCH_COMMAND}
+    && sed -i "s/OIDN_CUDA_SM_FLAGS 70 75 80 90 100 120/OIDN_CUDA_SM_FLAGS 75 80 90 100 110 120/" ${_OIDN_CUDA_CML}
+    && sed -i "s/OIDN_CUDA_SM80_FLAGS 80 90 100 120/OIDN_CUDA_SM80_FLAGS 80 90 100 110 120/" ${_OIDN_CUDA_CML}
+    && sed -i "s/OIDN_CUDA_SM70_FLAGS 70)/OIDN_CUDA_SM70_FLAGS 75)/" ${_OIDN_CUDA_CML}
+    && sed -i "s/smArch <= 109/smArch <= 119/" ${_OIDN_CUDA_DEV}
+  )
+endif()
+
 ExternalProject_Add(external_openimagedenoise
   URL file://${PACKAGE_DIR}/${OIDN_FILE}
   DOWNLOAD_DIR ${DOWNLOAD_DIR}
diff --git a/build_files/build_environment/cmake/osl.cmake b/build_files/build_environment/cmake/osl.cmake
index f629c964908..5758ff49298 100644
--- a/build_files/build_environment/cmake/osl.cmake
+++ b/build_files/build_environment/cmake/osl.cmake
@@ -55,7 +55,15 @@ set(OSL_EXTRA_ARGS
   -Dlibdeflate_DIR=${LIBDIR}/deflate/lib/cmake/libdeflate
 )
 
-if(NOT (APPLE OR BLENDER_PLATFORM_WINDOWS_ARM))
+# Thor aarch64 (BLENDER_PLATFORM_ARM): build CPU-only OSL, i.e. leave OSL_USE_OPTIX at its
+# upstream default of OFF. The OptiX/CUDA shadeops path compiles OSL's shadeops to PTX via
+# clang (LLVM_COMPILE_CUDA), which on CUDA 13 + our clang 17 breaks inside the CUDA runtime
+# header texture_fetch_functions.h. It is also useless here: Jetson has no OptiX runtime,
+# Blender is built WITH_CYCLES_DEVICE_OPTIX=OFF, and Cycles on the CUDA (non-OptiX) device
+# runs OSL on the CPU only. With OSL_USE_OPTIX=OFF, find_package(CUDA) is never called, so
+# the CUDA_FOUND-gated block in src/liboslexec/CMakeLists.txt is skipped and only the CPU
+# LLVM-bitcode path (USE_LLVM_BITCODE=ON) is compiled.
+if(NOT (APPLE OR BLENDER_PLATFORM_WINDOWS_ARM OR BLENDER_PLATFORM_ARM))
   list(APPEND OSL_EXTRA_ARGS
     -DOSL_USE_OPTIX=ON
     -DCUDA_TARGET_ARCH=sm_50

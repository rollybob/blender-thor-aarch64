diff --git a/build_files/build_environment/cmake/zstandard.cmake b/build_files/build_environment/cmake/zstandard.cmake
index ad7570153d7..0adbe9e096a 100644
--- a/build_files/build_environment/cmake/zstandard.cmake
+++ b/build_files/build_environment/cmake/zstandard.cmake
@@ -41,5 +41,11 @@ ExternalProject_Add(external_zstandard
 add_dependencies(
   external_zstandard
   external_python
+  # zstandard's setup.py does `from packaging.version import Version`, and `packaging` is installed
+  # into the deps Python by external_python_site_packages. Upstream 5.2 omits this edge (numpy and
+  # cython, also built as separate externals, both declare it) so under a parallel deps build
+  # zstandard can run before packaging is installed and fail: ModuleNotFoundError: No module named
+  # 'packaging'.
+  external_python_site_packages
   external_zstd
 )
diff --git a/build_files/cmake/platform/platform_unix.cmake b/build_files/cmake/platform/platform_unix.cmake
index 4719eb4b87e..3155e042f32 100644
--- a/build_files/cmake/platform/platform_unix.cmake
+++ b/build_files/cmake/platform/platform_unix.cmake
@@ -330,6 +330,14 @@ if(WITH_CODEC_FFMPEG)
   endif()
   find_package(FFmpeg)
 
+  # Thor aarch64: our deps-ffmpeg was built with DRM/kmsgrab support (libdrm present at deps-build
+  # time), so its static libavdevice/libavutil reference libdrm symbols. Blender's stock component
+  # list omits drm (their ffmpeg disables kmsgrab). Append system libdrm AFTER the ffmpeg static
+  # libs to resolve the undefined references at final link.
+  if(FFMPEG_FOUND)
+    list(APPEND FFMPEG_LIBRARIES drm)
+  endif()
+
   set_and_warn_library_found("FFmpeg" FFMPEG_FOUND WITH_CODEC_FFMPEG)
 endif()
 

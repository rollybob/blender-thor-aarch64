@@ -82,6 +82,11 @@ ExternalProject_Add(external_spirv_tools
 add_dependencies(
   external_spirv_tools
   external_spirv_headers
+  # external_spirv_tools configures with -DPython3_EXECUTABLE=${PYTHON_BINARY} and does
+  # find_package(Python3 REQUIRED ... Interpreter), so it must not configure before the deps

From 5bab148f1e577cbad33ac7f0c1d387ece310fb10 Mon Sep 17 00:00:00 2001
From: Thor aarch64 build <thor-build@localhost>
Date: Tue, 15 Sep 2026 12:50:21 -0400
Subject: [PATCH 7/8] deps: re-enable cmake/osl.cmake include (CPU-only OSL);
 keep mesa/weston off

Re-enable the OSL dependency include (built CPU-only per osl.cmake change). mesa and
wayland_weston stay commented out: leaf packages, aarch64-broken, and not needed --
Blender uses system GL and runs headless or on the system GNOME/X11 session.
---
 build_files/build_environment/CMakeLists.txt | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/build_files/build_environment/CMakeLists.txt b/build_files/build_environment/CMakeLists.txt
index af93de42f79..238ebb52927 100644
--- a/build_files/build_environment/CMakeLists.txt
+++ b/build_files/build_environment/CMakeLists.txt
@@ -71,7 +71,7 @@ endif()
 include(cmake/tbb.cmake)
 include(cmake/python.cmake)
 include(cmake/llvm.cmake)
-include(cmake/osl.cmake)
+include(cmake/osl.cmake)  # Thor aarch64: re-enabled as CPU-only OSL (OSL_USE_OPTIX gated off for ARM in osl.cmake; sidesteps the CUDA13/clang17 texture_fetch_functions.h GPU-shadeops failure)
 include(cmake/cython.cmake)
 include(cmake/numpy.cmake)
 include(cmake/zstandard.cmake)
@@ -168,12 +168,12 @@ endif()
 
 if(UNIX AND NOT APPLE)
   include(cmake/libglu.cmake)
-  include(cmake/mesa.cmake)
+  # include(cmake/mesa.cmake)  # EXCLUDED on Thor aarch64 (build fail; Blender will use system GL/EGL, headless Cycles needs no bundled mesa)
   include(cmake/wayland_protocols.cmake)
   # Can be removed when the build-bot upgrades to v1.20.x or newer.
   include(cmake/wayland.cmake)
   include(cmake/wayland_libdecor.cmake)
-  include(cmake/wayland_weston.cmake)
+  # include(cmake/wayland_weston.cmake)  # EXCLUDED on Thor aarch64 (needs cairo/xcb-randr/libinput; test compositor, not needed headless)
 endif()
 include(cmake/shaderc_deps.cmake)
 include(cmake/shaderc.cmake)
-- 
